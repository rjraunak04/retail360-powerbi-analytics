	column 'Annual Revenue'
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: annual_revenue

	column 'Year Opened'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: year_opened

	partition DimReseller = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(pServer, pDatabase, [CreateNavigationProperties=false]),
					Analytics = Source{[Schema="analytics", Item="dim_reseller"]}[Data]
				in
					Analytics

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
