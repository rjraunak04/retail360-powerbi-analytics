table DimReseller
	column 'Reseller Key'
		dataType: int64
		isHidden
		isKey
		formatString: #,0
		summarizeBy: none
		sourceColumn: reseller_key

	column 'Reseller Code'
		dataType: string
		summarizeBy: none
		sourceColumn: reseller_code

	column 'Reseller Name'
		dataType: string
		summarizeBy: none
		sourceColumn: reseller_name

	column 'Business Type'
		dataType: string
		summarizeBy: none
		sourceColumn: business_type

	column 'Number Employees'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: number_employees

	column 'Order Frequency'
		dataType: string
		summarizeBy: none
		sourceColumn: order_frequency

	column 'Order Month'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: order_month

	column 'First Order Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: first_order_year

	column 'Last Order Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: last_order_year

	column 'Product Line'
		dataType: string
		summarizeBy: none
