table FactInventory
	column 'Product Key'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: product_key

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: date_key

	column 'Movement Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: movement_date

		annotation UnderlyingDateTimeDataType = Date

	column 'Unit Cost'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: unit_cost

	column 'Units In'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: units_in

	column 'Units Out'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: units_out

	column 'Units Balance'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: units_balance

	column 'Net Units Movement'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: net_units_movement

	column 'Inventory Value'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: inventory_value

	partition FactInventory = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(
						pServer,
						pDatabase,
						[
							CreateNavigationProperties=false,
							Query="SELECT product_key, date_key, movement_date, unit_cost, units_in, units_out, units_balance, net_units_movement, inventory_value FROM analytics.fact_inventory"
						]
					)
				in
					Source

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
