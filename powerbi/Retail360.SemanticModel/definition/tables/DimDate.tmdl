table DimDate
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: date_key

	column 'Date'
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column 'Day Of Week'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: day_of_week

	column 'Day Name'
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

	column 'Day Of Month'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: day_of_month

	column 'Day Of Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: day_of_year

	column 'Week Of Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: week_of_year

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'Month Number'

	column 'Month Number'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: month_number

	column 'Calendar Quarter'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: calendar_quarter

	column 'Calendar Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: calendar_year

	column 'Calendar Semester'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: calendar_semester

	column 'Fiscal Quarter'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: fiscal_quarter

	column 'Fiscal Year'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: fiscal_year

	column 'Fiscal Semester'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: fiscal_semester

	column 'Year Month Key'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: year_month_key

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: year_month
		sortByColumn: 'Year Month Key'

	partition DimDate = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(pServer, pDatabase, [CreateNavigationProperties=false]),
					Analytics = Source{[Schema="analytics", Item="dim_date"]}[Data]
				in
					Analytics

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
