table DimChannel
	column 'Channel Key'
		dataType: int64
		isHidden
		isKey
		formatString: #,0
		summarizeBy: none
		sourceColumn: channel_key

	column 'Channel'
		dataType: string
		summarizeBy: none
		sourceColumn: channel_name

	partition DimChannel = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(pServer, pDatabase, [CreateNavigationProperties=false]),
					Analytics = Source{[Schema="analytics", Item="dim_channel"]}[Data]
				in
					Analytics

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
