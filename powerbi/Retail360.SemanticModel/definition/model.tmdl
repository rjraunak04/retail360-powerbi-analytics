model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["pServer","pDatabase","DimDate","DimProduct","DimCustomer","DimReseller","DimEmployee","DimGeography","DimSalesTerritory","DimPromotion","DimCurrency","DimChannel","FactSales","FactInventory","KPI_Measures"]
annotation __PBI_TimeIntelligenceEnabled = 1

ref table DimDate
ref table DimProduct
ref table DimCustomer
ref table DimReseller
ref table DimEmployee
ref table DimGeography
ref table DimSalesTerritory
ref table DimPromotion
ref table DimCurrency
ref table DimChannel
ref table FactSales
ref table FactInventory

ref table KPI_Measures

ref role RLS_North_America

ref role RLS_Europe

ref role RLS_Pacific
