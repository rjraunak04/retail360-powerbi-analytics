    ROW("Check", "Profit YTD", "Actual", IF(ISBLANK([Profit YTD]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit YTD]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Profit PY", "Actual", IF(ISBLANK([Profit PY]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit PY]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Profit YoY", "Actual", IF(ISBLANK([Profit YoY]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit YoY]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Profit YoY %", "Actual", IF(ISBLANK([Profit YoY %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit YoY %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Units YTD", "Actual", IF(ISBLANK([Units YTD]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Units YTD]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Units PY", "Actual", IF(ISBLANK([Units PY]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Units PY]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Units YoY %", "Actual", IF(ISBLANK([Units YoY %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Units YoY %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales by Due Date", "Actual", IF(ISBLANK([Sales by Due Date]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales by Due Date]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales by Ship Date", "Actual", IF(ISBLANK([Sales by Ship Date]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales by Ship Date]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Orders by Due Date", "Actual", IF(ISBLANK([Orders by Due Date]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Orders by Due Date]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Orders by Ship Date", "Actual", IF(ISBLANK([Orders by Ship Date]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Orders by Ship Date]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Customers", "Actual", IF(ISBLANK([Customers]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Customers]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Revenue per Customer", "Actual", IF(ISBLANK([Revenue per Customer]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Revenue per Customer]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Repeat Customers", "Actual", IF(ISBLANK([Repeat Customers]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Repeat Customers]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Repeat Customer %", "Actual", IF(ISBLANK([Repeat Customer %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Repeat Customer %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Resellers", "Actual", IF(ISBLANK([Resellers]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Resellers]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Revenue per Reseller", "Actual", IF(ISBLANK([Revenue per Reseller]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Revenue per Reseller]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Reseller Orders", "Actual", IF(ISBLANK([Reseller Orders]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Reseller Orders]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Products Sold", "Actual", IF(ISBLANK([Products Sold]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Products Sold]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Product Sales Share %", "Actual", IF(ISBLANK([Product Sales Share %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Product Sales Share %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Product Rank by Sales", "Actual", IF(ISBLANK([Product Rank by Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Product Rank by Sales]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Category Sales Share %", "Actual", IF(ISBLANK([Category Sales Share %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Category Sales Share %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Category Rank by Sales", "Actual", IF(ISBLANK([Category Rank by Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Category Rank by Sales]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Internet Sales", "Actual", IF(ISBLANK([Internet Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Internet Sales]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Reseller Sales", "Actual", IF(ISBLANK([Reseller Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Reseller Sales]), "PASS", "PASS"), "FAIL")),
