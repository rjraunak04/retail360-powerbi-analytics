// Retail360 Stage 6 all-measure runtime smoke test.
// Every governed measure is referenced so the live semantic engine must evaluate it.
// BLANK can be valid in an unfiltered context; only evaluation errors fail the test.

EVALUATE
UNION(
    ROW("Check", "Total Sales", "Actual", IF(ISBLANK([Total Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Total Sales]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Units Sold", "Actual", IF(ISBLANK([Units Sold]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Units Sold]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales Lines", "Actual", IF(ISBLANK([Sales Lines]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales Lines]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Distinct Orders", "Actual", IF(ISBLANK([Distinct Orders]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Distinct Orders]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Average Selling Price", "Actual", IF(ISBLANK([Average Selling Price]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Average Selling Price]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Average Order Value", "Actual", IF(ISBLANK([Average Order Value]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Average Order Value]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Average Units per Order", "Actual", IF(ISBLANK([Average Units per Order]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Average Units per Order]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Total Discount Amount", "Actual", IF(ISBLANK([Total Discount Amount]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Total Discount Amount]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Discount Rate", "Actual", IF(ISBLANK([Discount Rate]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Discount Rate]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Total Tax", "Actual", IF(ISBLANK([Total Tax]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Total Tax]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Total Freight", "Actual", IF(ISBLANK([Total Freight]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Total Freight]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Total Product Cost", "Actual", IF(ISBLANK([Total Product Cost]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Total Product Cost]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Gross Profit", "Actual", IF(ISBLANK([Gross Profit]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Gross Profit]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Gross Margin %", "Actual", IF(ISBLANK([Gross Margin %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Gross Margin %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Profit per Unit", "Actual", IF(ISBLANK([Profit per Unit]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit per Unit]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Profit per Order", "Actual", IF(ISBLANK([Profit per Order]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Profit per Order]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales MTD", "Actual", IF(ISBLANK([Sales MTD]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales MTD]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales QTD", "Actual", IF(ISBLANK([Sales QTD]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales QTD]), "PASS", "PASS"), "FAIL")),
