    ROW("Check", "Discounted Sales", "Actual", IF(ISBLANK([Discounted Sales]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Discounted Sales]), "PASS", "PASS"), "FAIL")),
