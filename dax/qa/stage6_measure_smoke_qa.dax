    ROW("Check", "Average Discount per Discounted Order", "Actual", IF(ISBLANK([Average Discount per Discounted Order]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Average Discount per Discounted Order]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Inventory Value (Snapshot Context)", "Actual", IF(ISBLANK([Inventory Value (Snapshot Context)]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Inventory Value (Snapshot Context)]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Inventory Units Balance", "Actual", IF(ISBLANK([Inventory Units Balance]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Inventory Units Balance]), "PASS", "PASS"), "FAIL")),
