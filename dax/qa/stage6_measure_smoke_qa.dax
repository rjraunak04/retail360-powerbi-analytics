    ROW("Check", "Sales PY", "Actual", IF(ISBLANK([Sales PY]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales PY]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales YoY", "Actual", IF(ISBLANK([Sales YoY]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales YoY]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales YoY %", "Actual", IF(ISBLANK([Sales YoY %]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales YoY %]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Sales Previous Month", "Actual", IF(ISBLANK([Sales Previous Month]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Sales Previous Month]), "PASS", "PASS"), "FAIL")),
