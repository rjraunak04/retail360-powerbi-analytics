    ROW("Check", "Inventory Units Out", "Actual", IF(ISBLANK([Inventory Units Out]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Inventory Units Out]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Net Inventory Movement", "Actual", IF(ISBLANK([Net Inventory Movement]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Net Inventory Movement]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Latest Inventory Date", "Actual", IF(ISBLANK([Latest Inventory Date]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Latest Inventory Date]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Current Inventory Value", "Actual", IF(ISBLANK([Current Inventory Value]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Current Inventory Value]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Current Inventory Units", "Actual", IF(ISBLANK([Current Inventory Units]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Current Inventory Units]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Average Inventory Value", "Actual", IF(ISBLANK([Average Inventory Value]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Average Inventory Value]), "PASS", "PASS"), "FAIL")),
    ROW("Check", "Inventory Turnover", "Actual", IF(ISBLANK([Inventory Turnover]), "BLANK", "VALUE"), "Expected", "evaluates", "Status", IFERROR(IF(ISBLANK([Inventory Turnover]), "PASS", "PASS"), "FAIL")),
